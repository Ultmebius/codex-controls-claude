{
  "mcpServers": {
    "claude-orchestrator": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/server/index.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "CCC_WAIT_MS": "1200000"
      },
      "tool_timeout_sec": 1260,
      "startup_timeout_sec": 120
    }
  }
}
