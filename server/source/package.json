{
  "name": "codex-controls-claude-server",
  "private": true,
  "type": "module",
  "version": "0.10.4",
  "scripts": {
    "build": "node build.mjs",
    "build:js": "node build.mjs --js-only",
    "build:native": "node build.mjs --native-only",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint src/ tests/",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "pretest": "node scripts/prepare-native-tests.mjs",
    "test": "vitest run && npm run test:contracts",
    "test:contracts": "node --test tests/event-wait.test.mjs package-tests/contracts.test.mjs",
    "test:native": "node scripts/native-self-test.mjs",
    "package:runtime": "node scripts/package-runtime.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.94",
    "@modelcontextprotocol/sdk": "1.27.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "esbuild": "0.27.3",
    "typescript": "5.9.3",
    "@types/node": "25.3.2",
    "@eslint/js": "9.39.3",
    "eslint": "9.39.3",
    "typescript-eslint": "8.56.1",
    "prettier": "3.8.1",
    "vitest": "4.0.18",
    "pngjs": "7.0.0",
    "sixel": "0.16.0"
  }
}
